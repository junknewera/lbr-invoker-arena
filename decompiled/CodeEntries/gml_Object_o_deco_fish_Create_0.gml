event_inherited();
var fish = array_random_item(global.fish_array);
sprite_index = fish.sprite;
alpha = random_range(0.4, 0.6);
lifetime = random_range(10, 30);
scale = random_range(0.5, 1);
scale_x = scale;
scale_x_final = scale;
scale_y = scale;
t = 0;
delay_instance(undefined, lifetime, instance_destroy);
alarm[0] = sec(random_range(1, 6));
direction = percent_chance(50) ? 0 : 180;
speed = percent_chance(50) ? random_range(0.25, 1) : 0;
speed_final = speed;
xmin = 320;
xmax = 720;
ymin = 250;
ymax = 380;
x = irandom_range(xmin, xmax);
y = irandom_range(ymin, ymax);
