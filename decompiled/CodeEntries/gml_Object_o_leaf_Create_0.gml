add_reward_flag = false;
armor = 1;
level = 1;
base_scale = random_range(0.75, 1.25);
bouncing = false;
can_damage_enemy = true;
can_draw_leaf_flag = true;
can_draw_shadow_flag = true;
can_merge = false;
community_leaf = false;
crumble_duration = 0;
crumble_timer = 0;
force_draw = false;
juiced = false;
merge_check = false;
mulched = false;
override_scale = 1;
scale = base_scale * level;
type = global.resources.leaves;
unique = false;
delta_time_current = 0;
delta_time_update = sec(0.5);
leaf_step_frame_index = 0;
image_draw_xscale = image_xscale * base_scale;
image_draw_yscale = image_yscale * base_scale;
image_alpha = 0;
image_index = irandom(image_number - 1);
_image_index = image_index;
image_xscale = 0;
image_yscale = 0;
image_speed = 0;
_speed = 1;
target_direction = 0;
target_rotation = irandom_range(-180, 180);
target_x = x + irandom_range(-60, 60);
target_y = y + irandom_range(-60, 60);
target_xscale = choose(scale, -scale);
target_yscale = choose(scale, -scale);
step_update_counter = 0;
step_update_interval = sec(0.1);
alarm[0] = 1;
init = leaf_instance_init;
init_after = __void;
can_draw_leaf_check = leaf_instance_can_draw_leaf_check;
can_draw_shadow = leaf_instance_can_draw_shadow;
can_draw_shadow_check = leaf_instance_draw_shadow_check;
destroy = leaf_instance_destroy;

set_merge_timeout = function()
{
    merge_check_timeout = true;
    alarm[3] = sec(1);
};
